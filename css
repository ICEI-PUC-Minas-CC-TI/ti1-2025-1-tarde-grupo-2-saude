/* Variáveis e Reset */
:root {
    --primary-color: #4a6fa5;
    --secondary-color: #6b8cae;
    --accent-color: #ff7e5f;
    --text-color: #2d3748;
    --light-bg: #f8f9fa;
    --card-bg: #ffffff;
    --border-color: #e2e8f0;
    --success-color: #48bb78;
    --warning-color: #ed8936;
    --error-color: #f56565;
    --font-main: 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --border-radius: 0.5rem;
    --box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --transition: all 0.3s ease;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    font-size: 16px;
    scroll-behavior: smooth;
}

body {
    font-family: var(--font-main);
    color: var(--text-color);
    line-height: 1.6;
    background-color: var(--light-bg);
    background-image: url('../assets/images/medical-bg.jpg');
    background-size: cover;
    background-attachment: fixed;
    background-position: center;
    background-blend-mode: overlay;
    background-color: rgba(248, 249, 250, 0.9);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

/* Layout */
.container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
}

.header {
    background-color: var(--primary-color);
    color: white;
    padding: 1.5rem 0;
    margin-bottom: 2rem;
    box-shadow: var(--box-shadow);
}

.logo {
    font-size: 2rem;
    font-weight: 700;
}

.tagline {
    font-size: 0.875rem;
    opacity: 0.9;
}

.main-content {
    flex: 1;
    padding: 1rem 0 3rem;
}

.section-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    color: var(--primary-color);
    font-size: 1.5rem;
}

.section-icon {
    width: 1.5rem;
    height: 1.5rem;
    fill: currentColor;
}

.footer {
    background-color: var(--primary-color);
    color: white;
    padding: 1.5rem 0;
    text-align: center;
    font-size: 0.875rem;
}

/* Cards */
.profile-card,
.symptoms-card,
.recommendation-card {
    background-color: var(--card-bg);
    border-radius: var(--border-radius);
    box-shadow: var(--box-shadow);
    padding: 1.5rem;
    margin-bottom: 2rem;
}

/* Perfil do Usuário */
.profile-card {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
}

.profile-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.profile-icon {
    width: 1.25rem;
    height: 1.25rem;
    fill: var(--primary-color);
}

.profile-label {
    font-weight: 600;
    color: var(--primary-color);
}

.profile-value {
    margin-left: 0.25rem;
}

/* Lista de Sintomas */
.symptoms-card {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.symptom-tag {
    background-color: var(--accent-color);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 1.5rem;
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    gap: 0.25rem;
}

.symptom-tag::before {
    content: "•";
    font-weight: bold;
}

/* Recomendações */
.recommendations-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
}

.recommendation-card {
    border-left: 4px solid var(--primary-color);
    transition: var(--transition);
}

.recommendation-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
}

.recommendation-specialty {
    font-size: 1.25rem;
    color: var(--primary-color);
    margin-bottom: 0.5rem;
    font-weight: 600;
}

.recommendation-reason {
    margin-bottom: 1rem;
    color: var(--text-color);
}

.recommendation-platform {
    display: inline-block;
    background-color: var(--secondary-color);
    color: white;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    margin-bottom: 1rem;
}

.recommendation-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background-color: var(--primary-color);
    color: white;
    text-decoration: none;
    border-radius: var(--border-radius);
    font-size: 0.875rem;
    transition: var(--transition);
}

.recommendation-link:hover {
    background-color: #3a5a8f;
}

.link-icon {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
}

.link-type {
    font-size: 0.75rem;
    color: var(--secondary-color);
    margin-top: 0.25rem;
    display: block;
}

/* Responsividade */
@media (max-width: 768px) {
    .profile-card {
        grid-template-columns: 1fr;
    }
    
    .recommendations-container {
        grid-template-columns: 1fr;
    }
}